{
  "base_stake": 0.02,
  "cashout": 1.45,
  "loss_multiplier": 3.15,
  "losses_before_rest": 3,
  "rest_rounds": 1,
  "recovery_attempts": 2,
  "stop_loss": 50.0,
  "start_balance": 60.08,
  "site_url": "https://bcmail2.com/game/crash",
  "headless": false,
  "selectors": {
    "balance": [
      "[data-testid='balance']",
      ".balance-amount",
      ".wallet-balance",
      "[class*='balance']",
      "[class*='Balance']",
      "[class*='wallet']",
      "[class*='Wallet']",
      "header >> text=/$/"
    ],
    "bet_amount": [
      "input[data-testid='bet-amount']",
      "input[placeholder*='Amount' i]",
      ".bet-input input",
      "[class*='bet'] input",
      "[class*='Bet'] input"
    ],
    "cashout": [
      "input[data-testid='cashout']",
      "input[placeholder*='Cash' i]",
      "input[placeholder*='Payout' i]",
      ".cashout-input input",
      "[class*='cashout'] input",
      "[class*='Cash'] input"
    ],
    "bet_button": [
      "button:has-text('Bet')",
      "button:has-text('Place Bet')",
      "[data-testid='bet-button']",
      "button.bet-button"
    ],
    "multiplier": [
      ".crash-multiplier",
      "[data-testid='multiplier']",
      ".game-multiplier",
      "text=/Starts in/i",
      "text=/\\d+\\.\\d+x/"
    ]
  }
}