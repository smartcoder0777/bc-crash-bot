{
  "manifest_version": 3,
  "name": "BC Crash Bot",
  "version": "1.1.3",
  "description": "Streak-low and single-green crash strategies. One bet per round, separate logs.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "*://*.bc.game/*",
    "*://bc.game/*",
    "*://*.bcmail2.com/*",
    "*://bcmail2.com/*"
  ],
  "action": {
    "default_title": "BC Crash Bot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bc.game/*",
        "*://bc.game/*",
        "*://*.bcmail2.com/*",
        "*://bcmail2.com/*"
      ],
      "js": [
        "strategy.js",
        "strategy-single-green.js",
        "config.js",
        "content.js"
      ],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
